<%- include('partials/header') %>

<h1 class="page-title">Cambiar contraseña</h1>

<% if (saved) { %>
  <div class="alert alert-success" role="alert">La contraseña ha cambiado</div>
  <a class="btn btn-primary" href="/user/preferences.php">Continuar</a>
<% } else { %>
  <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
  <form class="mform" method="post" action="/login/change_password.php">
    <div class="form-row">
      <label class="col-form-label">Nombre de usuario</label>
      <div class="form-field form-static"><%= user.username %></div>
    </div>
    <div class="form-row">
      <label class="col-form-label" for="password">Contraseña actual <i class="fa fa-circle-exclamation text-danger" title="Requerido"></i></label>
      <div class="form-field"><input type="password" class="form-control" id="password" name="password" autocomplete="current-password" required></div>
    </div>
    <div class="form-row">
      <label class="col-form-label" for="newpassword1">Nueva contraseña <i class="fa fa-circle-exclamation text-danger" title="Requerido"></i></label>
      <div class="form-field"><input type="password" class="form-control" id="newpassword1" name="newpassword1" autocomplete="new-password" required></div>
    </div>
    <div class="form-row">
      <label class="col-form-label" for="newpassword2">Nueva contraseña (de nuevo) <i class="fa fa-circle-exclamation text-danger" title="Requerido"></i></label>
      <div class="form-field"><input type="password" class="form-control" id="newpassword2" name="newpassword2" autocomplete="new-password" required></div>
    </div>
    <hr class="form-separator">
    <div class="form-buttons">
      <button type="submit" class="btn btn-primary">Guardar cambios</button>
      <a class="btn btn-secondary" href="/user/preferences.php">Cancelar</a>
    </div>
  </form>
<% } %>

<%- include('partials/footer') %>
