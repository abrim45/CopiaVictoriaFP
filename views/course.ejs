<%- include('partials/header') %>
<%- include('partials/course-header') %>

<div class="course-content" data-course="<%= course.id %>">
  <% sections.forEach((s, i) => { %>
    <section class="course-section card" id="section-<%= s.position %>" data-section="<%= s.id %>">
      <div class="section-header">
        <button type="button" class="section-chevron" aria-expanded="true" aria-controls="section-body-<%= s.id %>" title="Colapsar"><i class="fa fa-chevron-down"></i></button>
        <h3 class="sectionname"><%= s.name %></h3>
        <% if (i === 0) { %>
          <a href="#" class="collapse-all">Colapsar todo</a>
        <% } %>
      </div>
      <div class="section-body" id="section-body-<%= s.id %>">
        <% if (s.summary) { %><div class="section-summary"><%- s.summary %></div><% } %>
        <ul class="activities">
          <% s.activities.forEach(a => { %>
            <% if (a.type === 'label') { %>
              <li class="activity activity-label"><%- a.intro %></li>
            <% } else { %>
              <li class="activity" id="module-<%= a.id %>">
                <%- icons.modIcon(a.type) %>
                <div class="activity-info">
                  <div class="activity-name-line">
                    <a class="activityname" href="<%= icons.modUrl(a) %>"<%= a.type === 'url' ? ' target="_blank" rel="noopener"' : '' %>><%= a.name %></a>
                    <% if (a.type === 'resource') { %><span class="resourcelinkdetails">PDF</span><% } %>
                  </div>
                  <% if (a.type === 'assign' && (a.open_date || a.due_date)) { %>
                    <div class="activity-dates">
                      <% if (a.open_date) { %><span><strong>Apertura:</strong> <%= fmt.userdate(a.open_date) %></span><% } %>
                      <% if (a.due_date) { %><span><strong>Cierre:</strong> <%= fmt.userdate(a.due_date) %></span><% } %>
                    </div>
                  <% } %>
                </div>
              </li>
            <% } %>
          <% }) %>
        </ul>
      </div>
    </section>
  <% }) %>
</div>

<%- include('partials/footer', { scripts: ['/js/course.js'] }) %>
